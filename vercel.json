{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nuxtjs",
      "buildCommand": "npm run generate",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/games/[^/]+/?", "dest": "/200.html" },
        { "handle": "error" },
        { "src": "/(.*)", "status": 404, "dest": "/404.html" }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "flask",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
